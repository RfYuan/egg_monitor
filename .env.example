# 飞书群机器人 Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_here

# TqSdk 账号（可选，如不用TqSdk可留空）
TQSDK_USERNAME=
TQSDK_PASSWORD=

# 大商所API配置
DCE_API_KEY=your_api_key_here
DCE_API_SECRET=your_api_secret_here
DCE_API_URL=http://www.dce.com.cn

# 数据库配置
DB_PATH=data/db/egg_monitor.db

# API服务配置
API_HOST=127.0.0.1
API_PORT=8000

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
